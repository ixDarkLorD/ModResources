<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.ixdarklord.folios</groupId>
  <artifactId>folios-fabric</artifactId>
  <version>26.1.2+1.0</version>
  <name>Folios [fabric]</name>
  <description>Guide books for mods, written as JSON in a resource pack: a book on the screen or held open in your hands, with recipes, builds, quests and more.</description>
  <url>https://github.com/ixDarkLorD/Folios</url>
  <licenses>
    <license>
      <name>LicenseRef-Folios-License</name>
      <url>https://spdx.org/licenses/LicenseRef-Folios-License.html</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ixdarklord</id>
      <name>ixDarkLorD</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ixDarkLorD/Folios.git</connection>
    <developerConnection>scm:git:git@github.com:ixDarkLorD/Folios.git</developerConnection>
    <url>https://github.com/ixDarkLorD/Folios</url>
  </scm>
  <issueManagement>
    <system>github</system>
    <url>https://github.com/ixDarkLorD/Folios/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>net.fabricmc.fabric-api</groupId>
      <artifactId>fabric-api</artifactId>
      <version>0.155.3+26.1.2</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>fabric-api-deprecated</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>net.fabricmc</groupId>
      <artifactId>fabric-loader</artifactId>
      <version>0.19.3</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.terraformersmc</groupId>
      <artifactId>modmenu</artifactId>
      <version>18.0.2</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>net.fabricmc.fabric-api</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>net.ixdarklord.coolcatlib</groupId>
      <artifactId>coolcatlib-fabric</artifactId>
      <version>26.1.2-6</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
