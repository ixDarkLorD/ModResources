<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.ixdarklord.wheredidiputit</groupId>
  <artifactId>wheredidiputit-fabric</artifactId>
  <version>1.21.1-1</version>
  <name>Where Did I Put It? [fabric]</name>
  <description>Hover an item, press a key, and the nearest container holding it lights up. Remembers what's in every chest you open.</description>
  <url>https://github.com/ixDarkLorD/WhereDidIPutIt</url>
  <licenses>
    <license>
      <name>MPL-2.0</name>
      <url>https://spdx.org/licenses/MPL-2.0.html</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ixdarklord</id>
      <name>ixDarkLorD</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ixDarkLorD/WhereDidIPutIt.git</connection>
    <developerConnection>scm:git:git@github.com:ixDarkLorD/WhereDidIPutIt.git</developerConnection>
    <url>https://github.com/ixDarkLorD/WhereDidIPutIt</url>
  </scm>
  <issueManagement>
    <system>github</system>
    <url>https://github.com/ixDarkLorD/WhereDidIPutIt/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>net.fabricmc.fabric-api</groupId>
      <artifactId>fabric-api</artifactId>
      <version>0.116.5+1.21.1</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>fabric-api-deprecated</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>net.fabricmc</groupId>
      <artifactId>fabric-loader</artifactId>
      <version>0.17.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.terraformersmc</groupId>
      <artifactId>modmenu</artifactId>
      <version>11.0.3</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>net.fabricmc.fabric-api</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>net.ixdarklord.coolcatlib</groupId>
      <artifactId>coolcatlib-fabric</artifactId>
      <version>1.21.1-2100.4.0.0</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
